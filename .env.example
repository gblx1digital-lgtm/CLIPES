# Copie para .env e preencha. NUNCA versione o .env.

# --- IA (obrigatório para encontrar cortes) -------------------------------
# console.anthropic.com > API Keys. Cobrança por uso.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (mais alto = análise mais cuidadosa e mais cara)
AI_EFFORT=medium
# Candidatos avaliados por requisição e quadros enviados por candidato
AI_MAX_CANDIDATES_PER_REQUEST=6
AI_FRAMES_PER_CANDIDATE=4

# --- Monitoramento de canais (opcional, apenas metadados) -----------------
# Google Cloud Console > APIs e serviços > YouTube Data API v3 > Credenciais
YOUTUBE_API_KEY=
# dev.twitch.tv/console > Register Your Application
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Google Drive (pastas compartilhadas pelos criadores). Vazio = usa a YOUTUBE_API_KEY;
# ative a "Google Drive API" na mesma chave no Google Cloud.
GOOGLE_API_KEY=

# --- Transcrição de fala (opcional) ----------------------------------------
# none | faster_whisper   (faster_whisper: pip install -r backend/requirements-transcription.txt)
TRANSCRIPTION_PROVIDER=none
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=pt

# --- Acesso ao painel (OBRIGATÓRIO quando publicado na internet) ---------
APP_USER=admin
APP_PASSWORD=

# --- Infra -----------------------------------------------------------------
# Padrão: SQLite em data/clipes.db. Produção: postgresql+psycopg://usuario:senha@host:5432/clipes
# DATABASE_URL=
# STORAGE_DIR=./data/storage
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=8192
LOG_LEVEL=INFO
